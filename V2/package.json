{
  "name": "socrates-dl",
  "version": "1.0.0",
  "description": "SOCRATES-DL -- WSG -- V1 | DepotDownloader GUI",
  "author": "WSG",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.wsg.socrates-dl",
    "productName": "SOCRATES-DL",
    "win": {
      "target": "nsis",
      "icon": "socrates_icon.ico"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "libs/**",
      "socrates_icon.ico"
    ],
    "extraResources": [
      {
        "from": "libs",
        "to": "libs"
      }
    ]
  }
}
